#cloud-config
hostname: ${hostname}
prefer_fqdn_over_hostname: false
manage_etc_hosts: true
autostart: true

# AUTOMATED SECONDARY VOLUME PARTITIONING (scsi1 -> /dev/sdb)
disk_setup:
  /dev/sdb:
    table_type: 'gpt'
    layout: true
    overwrite: false

fs_setup:
  - filesystem: xfs
    device: /dev/sdb1

mounts:
  - [ /dev/sdb1, /var/lib/pgsql, xfs, "defaults,noatime", "0", "0" ]

users:
  - name: secops
    groups: wheel
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - "${ssh_key}"

runcmd:
  - hostnamectl set-hostname ${hostname}
  - localectl set-keymap fr
  - chown -R postgres:postgres /var/lib/pgsql
  - restorecon -Rv /var/lib/pgsql
  - postgresql-setup --initdb --unit postgresql
  
  # Allow local password authentication (md5) for Zabbix setup.php
  - sed -i '1i host    all             all             127.0.0.1/32            md5\nhost    all             all             ::1/128                 md5' /var/lib/pgsql/data/pg_hba.conf
  - systemctl enable --now postgresql
  
  # Create Zabbix DB & User with standard initial password (for setup.php)
  - sudo -u postgres psql -c "CREATE USER zabbix WITH PASSWORD 'zabbix';"
  - sudo -u postgres psql -c "CREATE DATABASE zabbix OWNER zabbix;"
  - zcat /usr/share/zabbix-sql-scripts/postgresql/server.sql.gz | sudo -u zabbix psql zabbix
  - sed -i "s/# DBPassword=/DBPassword=zabbix/" /etc/zabbix/zabbix_server.conf
  
  - sed -i 's/# listen 80;/listen 80;/' /etc/nginx/conf.d/zabbix.conf
  - sed -i 's/# server_name example.com;/server_name _;/' /etc/nginx/conf.d/zabbix.conf
  - firewall-cmd --permanent --add-service={http,https}
  - firewall-cmd --permanent --add-port=10051/tcp
  - firewall-cmd --reload
  - systemctl enable postgresql zabbix-server nginx php-fpm
  - systemctl restart postgresql zabbix-server nginx php-fpm
